ANTHROPIC_API_KEY=
# external_llm (default) or deterministic. Deterministic mode does not require ANTHROPIC_API_KEY.
DEMEU_PROCESSING_MODE=external_llm
TELEGRAM_BOT_TOKEN=
TELEGRAM_DOCTOR_CHAT_IDS=
TELEGRAM_DOCTOR_CHAT_ID=
DOCTOR_ACCESS_CODE=
APP_BASE_URL=http://localhost:3000
# Production: APP_BASE_URL=https://specimen-ai.govtech-kz.com
DEMEU_DOMAIN=specimen-ai.govtech-kz.com
APP_PORT=8019
NODE_ENV=development
TLS_BRANCH=branch-a-caddy

# Optional workspace: configure all three together; see docs/workspace-accounts.md.
# Keep commented while disabled: even an empty auth variable requests workspace mode.
# DEMEU_ACCOUNTS_FILE=
# DEMEU_AUTH_SECRET=
# DEMEU_DATA_DIR=

# Optional MIS pull integration. The credential file is mounted outside Git and
# is reread for every request so key rotation and revocation do not need restart.
# Stage 6 deployment may use this host-only path to create the reviewed read-only mount.
# DEMEU_HOST_MIS_CREDENTIALS_FILE=/secure/host/path/demeu-mis-credentials.json
# DEMEU_MIS_CREDENTIALS_FILE=/run/secrets/demeu-mis-credentials.json
# Research-only B3 events remain disabled unless this exact acknowledgement is set.
# DEMEU_MIS_RESEARCH_EVENTS=I_ACKNOWLEDGE_RESEARCH_ONLY

ANTHROPIC_API_KEY=
# external_llm (default) or deterministic. Deterministic mode does not require ANTHROPIC_API_KEY.
DEMEU_PROCESSING_MODE=external_llm
TELEGRAM_BOT_TOKEN=
TELEGRAM_DOCTOR_CHAT_IDS=
TELEGRAM_DOCTOR_CHAT_ID=
DOCTOR_ACCESS_CODE=
APP_BASE_URL=http://localhost:3000
# Production: APP_BASE_URL=https://specimen-ai.govtech-kz.com
DEMEU_DOMAIN=specimen-ai.govtech-kz.com
APP_PORT=8019
NODE_ENV=development
TLS_BRANCH=branch-a-caddy

# Optional workspace: configure all three together; see docs/workspace-accounts.md.
# Keep commented while disabled: even an empty auth variable requests workspace mode.
# DEMEU_ACCOUNTS_FILE=
# DEMEU_AUTH_SECRET=
# DEMEU_DATA_DIR=

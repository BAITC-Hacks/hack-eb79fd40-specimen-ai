{
  "name": "govtech-demeu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "demo:mock": "node --import tsx scripts/demo-mock.mjs",
    "build": "next build",
    "eval": "tsx scripts/eval.ts",
    "e2e:live": "E2E_LIVE=1 node scripts/e2e.mjs",
    "e2e:scenario1:live": "LIVE_E2E=1 node --env-file=.env --import tsx scripts/live-scenario1.ts",
    "e2e:scenario1:production-once": "bash deploy/smoke-scenario1-once.sh",
    "e2e:mock": "node scripts/e2e-mock.mjs",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:analytics:live": "LIVE_ANALYTICS=I_AUTHORIZE_THREE_STRUCTURED_EXTRACTIONS node --env-file=.env --import tsx scripts/live-analytics-smoke.ts",
    "test:healthz:standalone": "npm run build && docker run --pull never --rm --network none -v \"$PWD:/workspace:ro\" -w /workspace node:24-alpine node tests/integration/healthz-standalone.mjs",
    "test:llm:live": "vitest run --config vitest.live.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "next": "~15.5.24",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "~15.5.24",
    "tsx": "^4.23.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.4"
    }
  }
}
